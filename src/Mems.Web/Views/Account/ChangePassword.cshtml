@model ChangePasswordForm
@*
 * Project: Municipal Elections Management System (MEMS)
 * Course: COMP4976
 * Authors: Abdullah Rehan, Alex Fisher (project contributors)
 * Description: Allows administrators to change their own password.
*@
@{ ViewData["Title"] = "Change password"; }
<div class="mx-auto" style="max-width:460px">
    <h1 class="h2">Change password</h1>
    <p class="text-secondary">Change the password for your signed-in administrator account.</p>
    <form asp-area="" asp-controller="Account" asp-action="ChangePassword" method="post" class="panel mt-4">
        <div asp-validation-summary="All" role="alert"></div>
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label"></label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmNewPassword" class="form-label"></label>
            <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmNewPassword"></span>
        </div>
        <button class="btn btn-primary" type="submit">Change password</button>
    </form>
    <a class="d-inline-block mt-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Back to administration</a>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
