@model List<Municipality>
@*
 * Project: Municipal Elections Management System (MEMS)
 * Course: COMP4976
 * Authors: Abdullah Rehan, Alex Fisher (project contributors)
 * Description: Introduces public municipality browsing and the personal voting guide.
*@@{ ViewData["Title"] = "Your community. Your choice."; }
<section class="hero">
    <div class="eyebrow mb-3">LOCAL ELECTIONS · BRITISH COLUMBIA</div>
    <h1>Your community.<br />Your choice.</h1>
    <p class="mt-3 mb-4">Get to know your local candidates. Explore the positions, make your selections, and bring a personal voting guide with you.</p>
    <a class="btn btn-primary" asp-controller="Directory" asp-action="Index">Explore candidates <span aria-hidden="true">→</span></a>
    <span class="hero-meta ms-sm-3 mt-3 mt-sm-0">Election date · October 17, 2026</span>
</section>
<div class="section-heading"><div><div class="eyebrow">START HERE</div><h2 class="mb-0 mt-2">Find your municipality</h2></div><span class="text-secondary">@Model.Count communities</span></div>
<div class="row g-4">
@foreach (var municipality in Model)
{
    <div class="col-md-6 col-xl-3"><article class="card h-100"><div class="card-body d-flex flex-column align-items-start">
        @if (municipality.LogoFileName is not null) { <img class="municipal-icon mb-4" src="/media/@municipality.LogoFileName" alt="@municipality.Name logo" /> }
        else { <div class="municipal-icon mb-4" aria-hidden="true">@municipality.Name[..1]</div> }
        <h3>@municipality.Name</h3><p class="text-secondary small mb-3">@municipality.Province<br />Election: @municipality.ElectionDate.ToString("MMMM d, yyyy")</p>
        <a class="mt-auto fw-semibold" asp-action="Details" asp-route-id="@municipality.MunicipalityId">Explore community <span aria-hidden="true">→</span></a>
    </div></article></div>
}
</div>
@if (Model.Count == 0) { <div class="empty">No municipalities have been added yet.</div> }
<div class="panel mt-5 row g-3 mx-0"><div class="col-md-4"><h3>1. Explore</h3><p class="text-secondary mb-0">Find the candidates for each local position.</p></div><div class="col-md-4"><h3>2. Make your list</h3><p class="text-secondary mb-0">Save your choices without creating an account.</p></div><div class="col-md-4"><h3>3. Print your guide</h3><p class="text-secondary mb-0">Take a convenient reminder with you. This guide is not an official ballot.</p></div></div>
